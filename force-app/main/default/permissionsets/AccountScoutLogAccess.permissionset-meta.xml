<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Account Scout Log Access</label>
    <description>Grants read/create access to AccountScoutLog__c and its fields so the audit log can be viewed via Setup, list views, reports, and the API.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <objectPermissions>
        <object>AccountScoutLog__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <fieldPermissions>
        <field>AccountScoutLog__c.UserQuery__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>AccountScoutLog__c.CitedRecordIds__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
</PermissionSet>
